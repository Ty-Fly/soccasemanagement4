# Kopieer naar .env.local en pas aan.

# Waar draait de .NET-backend? (launchSettings.json: https://localhost:7181)
VITE_BACKEND_URL=https://localhost:7181

# mock = alle data komt uit de demo-store in de browser (geen backend nodig)
# live = endpoints die al in de backend bestaan worden echt aangeroepen
VITE_API_MODE=live
